rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // News articles: Public can read, write
    match /news/{newsId} {
      allow read, write: if isValidId(newsId);
    }

    // Categories: Public can read, write
    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    // Breaking news items: Public can read, write
    match /breakingNews/{breakingId} {
      allow read, write: if isValidId(breakingId);
    }

    // Site settings: Public can read, write
    match /siteSettings/{settingsId} {
      allow read, write: if isValidId(settingsId);
    }

    // Ad settings: Public can read, write
    match /adSettings/{adId} {
      allow read, write: if isValidId(adId);
    }

    // Comments: Public can read and write
    match /comments/{commentId} {
      allow read, write: if isValidId(commentId);
    }
  }
}

